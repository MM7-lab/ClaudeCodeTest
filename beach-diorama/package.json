{
  "name": "beach-diorama",
  "version": "1.1.0",
  "description": "A low-poly 3D beach diorama that floats on top of the Windows desktop (Electron + Three.js).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node tools/vendor-three.mjs",
    "start": "electron .",
    "predist": "node tools/vendor-three.mjs",
    "dist": "electron-builder --win --publish never",
    "prepack": "node tools/vendor-three.mjs",
    "pack": "electron-builder --win dir --publish never"
  },
  "license": "MIT",
  "author": "MM7-lab",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "org.mm7lab.beachdiorama",
    "productName": "Hong Kong Diorama",
    "artifactName": "HongKongDiorama-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "scene/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "HongKongDiorama-${version}-portable.exe"
    }
  }
}
