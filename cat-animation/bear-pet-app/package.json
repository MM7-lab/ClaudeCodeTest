{
  "name": "bear-desk-pet",
  "productName": "Bear Pet",
  "version": "1.0.0",
  "description": "Bear Pet desktop pet",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "lab.mm7.bearpet",
    "productName": "Bear Pet",
    "files": [
      "main.js",
      "preload.js",
      "pet.html",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "BearPet-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "BearPet-${version}-setup.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "copyright": "© 2026 MM7 Lab"
  },
  "author": "MM7 Lab"
}
